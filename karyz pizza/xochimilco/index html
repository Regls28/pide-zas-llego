<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Kary'z Pizza — Xochimilco</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Montserrat:wght@400;600;700;900&amp;family=Nunito:wght@400;600&amp;display=swap" rel="stylesheet"/>
<style>
  :root {
    --azul:   #1A2ECC;
    --azul2:  #0d1a8a;
    --rojo:   #CC1A1A;
    --amarillo:#F5C518;
    --dorado: #D4A017;
    --negro:  #050810;
    --gris:   #0d1020;
    --gris2:  #141828;
    --blanco: #FFFFFF;
    --muted:  #a8b8d8;
  }
  *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Nunito',sans-serif; background:var(--negro); color:var(--blanco); overflow-x:hidden; }

  /* ── HERO ── */
  .hero {
    position:relative; min-height:100vh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:3rem 1.5rem 5rem;
    background:
      radial-gradient(ellipse at 30% 30%, rgba(26,46,204,.45) 0%, transparent 60%),
      radial-gradient(ellipse at 75% 70%, rgba(204,26,26,.3) 0%, transparent 55%),
      url('https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=1400&q=80') center/cover no-repeat;
  }
  .hero::after { content:''; position:absolute; inset:0; background:linear-gradient(to bottom,rgba(5,8,16,.7) 0%,rgba(5,8,16,.94) 100%); z-index:0; }
  .hero > * { position:relative; z-index:1; }

  .logo-wrap { margin-bottom:1rem; }
  .logo-karyz { font-family:'Bebas Neue',sans-serif; font-size:clamp(4.5rem,14vw,9rem); color:var(--blanco); line-height:.85; letter-spacing:.05em; text-shadow:4px 4px 0 var(--azul),0 0 50px rgba(26,46,204,.5); }
  .logo-pizza { font-family:'Bebas Neue',sans-serif; font-size:clamp(2.5rem,8vw,5rem); color:var(--rojo); letter-spacing:.14em; }

  .tagline { font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(.7rem,2vw,.9rem); letter-spacing:.25em; text-transform:uppercase; color:var(--amarillo); margin-bottom:2rem; border-top:1px solid rgba(245,197,24,.35); border-bottom:1px solid rgba(245,197,24,.35); padding:.5rem 2rem; }

  .domicilio-banner { background:rgba(26,46,204,.15); border:1.5px solid var(--azul); border-radius:12px; padding:.8rem 2rem; font-family:'Montserrat',sans-serif; font-weight:700; font-size:clamp(.75rem,2vw,.92rem); color:rgba(180,200,255,.9); letter-spacing:.05em; text-transform:uppercase; margin-bottom:2rem; }
  .domicilio-banner span { color:var(--blanco); }

  .hero-chips { display:flex; gap:.9rem; flex-wrap:wrap; justify-content:center; }
  .chip { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.15); border-radius:40px; padding:.5rem 1.1rem; font-size:.78rem; font-weight:600; display:flex; align-items:center; gap:.4rem; }

  /* ── SECCIONES ── */
  section { padding:4.5rem 1.5rem; }
  .max-w { max-width:1180px; margin:0 auto; }

  .sec-title { font-family:'Bebas Neue',sans-serif; font-size:clamp(2rem,6vw,3.2rem); letter-spacing:.07em; display:inline-block; position:relative; padding-bottom:.4rem; }
  .sec-title::after { content:''; position:absolute; left:0; bottom:0; width:55%; height:4px; background:var(--rojo); border-radius:2px; }
  .sec-title.azul::after  { background:var(--azul); }
  .sec-title.dorado::after{ background:var(--dorado); }
  .sec-title.centered { display:block; text-align:center; }
  .sec-title.centered::after { left:22.5%; }

  /* ── PIZZAS ESPECIALES ── */
  #especiales { background:linear-gradient(135deg,#050810,#0a0f28); }

  .esp-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1.4rem; margin-top:2.5rem; }
  .esp-card { background:rgba(0,0,0,.5); border-radius:18px; overflow:hidden; border:1px solid rgba(255,255,255,.08); transition:transform .2s,box-shadow .2s; }
  .esp-card:hover { transform:translateY(-5px); box-shadow:0 14px 40px rgba(0,0,0,.7); }
  .esp-head { padding:.9rem 1.3rem; display:flex; align-items:center; justify-content:space-between; }
  .eh-barra  { background:linear-gradient(90deg,#0d1a8a,#1A2ECC); }
  .eh-rect   { background:linear-gradient(90deg,#8B0000,#CC1A1A); }
  .esp-nombre { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; letter-spacing:.06em; color:var(--blanco); line-height:1.1; }
  .esp-nombre small { display:block; font-size:.65rem; font-family:'Montserrat',sans-serif; font-weight:600; color:rgba(255,255,255,.65); letter-spacing:.07em; }
  .esp-precio { font-family:'Bebas Neue',sans-serif; font-size:2.4rem; color:var(--amarillo); }
  .esp-body { padding:1.1rem 1.4rem; }
  .esp-body ul { list-style:none; display:flex; flex-direction:column; gap:.45rem; }
  .esp-body ul li { font-size:.82rem; color:rgba(255,255,255,.8); display:flex; align-items:flex-start; gap:.55rem; line-height:1.5; }
  .esp-body ul li::before { content:'✔'; color:var(--amarillo); font-weight:700; font-size:.78rem; flex-shrink:0; margin-top:.15rem; }
  .orilla-tag { display:inline-flex; align-items:center; gap:.4rem; background:rgba(212,160,23,.12); border:1px solid rgba(212,160,23,.35); border-radius:8px; padding:.28rem .75rem; font-size:.7rem; color:var(--dorado); font-family:'Montserrat',sans-serif; font-weight:600; margin-top:.7rem; }
  .no2x1-tag { display:inline-flex; align-items:center; background:rgba(204,26,26,.15); border:1px solid rgba(204,26,26,.35); border-radius:8px; padding:.28rem .75rem; font-size:.68rem; color:#ffb4a7; font-family:'Montserrat',sans-serif; font-weight:700; margin-top:.4rem; }

  /* ── 2×1 ── */
  #dosxuno { background:var(--gris); }

  .tam-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1.2rem; margin-top:2.5rem; }
  .tam-card { background:var(--negro); border-radius:16px; padding:1.6rem 1.2rem; text-align:center; border:2px solid rgba(26,46,204,.25); position:relative; overflow:hidden; transition:transform .2s,border-color .2s; }
  .tam-card:hover { transform:translateY(-5px); border-color:var(--azul); }
  .tam-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,var(--azul),var(--rojo)); }
  .tam-label  { font-family:'Bebas Neue',sans-serif; font-size:1.5rem; letter-spacing:.1em; color:var(--blanco); margin-bottom:.3rem; }
  .tam-badge  { display:inline-block; background:var(--rojo); color:var(--amarillo); font-family:'Bebas Neue',sans-serif; font-size:.95rem; letter-spacing:.08em; border-radius:20px; padding:.1rem .8rem; margin-bottom:.7rem; }
  .tam-precio { font-family:'Bebas Neue',sans-serif; font-size:clamp(2.5rem,5.5vw,3.3rem); color:var(--amarillo); line-height:1; }

  /* ── ESPECIALIDADES ── */
  #especialidades { background:var(--negro); }

  .pizza-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:1rem; margin-top:2.5rem; }
  .pizza-card { background:var(--gris2); border-radius:12px; padding:1rem 1.2rem; border-left:4px solid var(--azul); transition:transform .2s,border-color .2s; }
  .pizza-card:hover { transform:translateY(-3px); border-color:var(--amarillo); }
  .pizza-card.dest  { border-left-color:var(--dorado); }
  .pizza-card.prem  { border-left-color:#7b2ff7; }
  .pizza-card.mar   { border-left-color:#00c4ff; }
  .pizza-card h3 { font-family:'Montserrat',sans-serif; font-weight:900; font-size:.85rem; text-transform:uppercase; letter-spacing:.05em; color:var(--blanco); margin-bottom:.35rem; }
  .pizza-card.dest h3 { color:var(--amarillo); }
  .pizza-card.prem h3 { color:#c8a8ff; }
  .pizza-card.mar  h3 { color:#80e4ff; }
  .pizza-card p { font-size:.77rem; color:rgba(255,255,255,.52); line-height:1.5; }

  /* tabla premium / marisco */
  .price-row { display:flex; justify-content:space-between; align-items:center; margin-top:.6rem; flex-wrap:wrap; gap:.3rem; }
  .price-pill { font-family:'Bebas Neue',sans-serif; font-size:.9rem; letter-spacing:.04em; }
  .price-pill span { background:rgba(26,46,204,.25); border:1px solid rgba(26,46,204,.4); border-radius:6px; padding:.1rem .55rem; color:var(--amarillo); }
  .price-pill.pur span { background:rgba(123,47,247,.25); border-color:rgba(123,47,247,.4); }
  .price-pill.cya span { background:rgba(0,196,255,.15); border-color:rgba(0,196,255,.3); }

  /* ── PROMOS ── */
  #promos { background:var(--gris); }

  .promo-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1.4rem; margin-top:2.5rem; }
  .promo-card { background:var(--negro); border-radius:18px; overflow:hidden; border:1px solid rgba(255,255,255,.07); transition:transform .2s,box-shadow .2s; }
  .promo-card:hover { transform:translateY(-5px); box-shadow:0 14px 40px rgba(0,0,0,.6); }
  .promo-head { padding:.9rem 1.3rem; display:flex; align-items:center; justify-content:space-between; }
  .ph-1 { background:linear-gradient(90deg,#0d1a8a,#1A2ECC); }
  .ph-2 { background:linear-gradient(90deg,#8B0000,#CC1A1A); }
  .ph-3 { background:linear-gradient(90deg,#1a4a00,#2A8B00); }
  .ph-c { background:linear-gradient(90deg,#6B001A,#CC1A55); }
  .promo-nombre { font-family:'Bebas Neue',sans-serif; font-size:1.3rem; letter-spacing:.06em; color:var(--blanco); line-height:1.1; }
  .promo-nombre small { display:block; font-size:.62rem; font-family:'Montserrat',sans-serif; font-weight:600; color:rgba(255,255,255,.65); letter-spacing:.07em; }
  .promo-precio { font-family:'Bebas Neue',sans-serif; font-size:2.2rem; color:var(--amarillo); }
  .promo-body { padding:1rem 1.3rem; }
  .promo-body ul { list-style:none; display:flex; flex-direction:column; gap:.45rem; }
  .promo-body ul li { font-size:.81rem; color:rgba(255,255,255,.8); display:flex; align-items:flex-start; gap:.5rem; line-height:1.5; }
  .promo-body ul li::before { content:'✔'; color:var(--dorado); font-weight:700; font-size:.78rem; flex-shrink:0; margin-top:.15rem; }

  /* ── ANTOJITOS & BEBIDAS ── */
  #antojitos { background:var(--negro); }

  .otros-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1.2rem; margin-top:2.5rem; }
  .otro-card { background:var(--gris2); border-radius:14px; padding:1.2rem 1.4rem; display:flex; flex-direction:column; justify-content:space-between; border-bottom:3px solid var(--azul); transition:transform .2s; }
  .otro-card:hover { transform:translateY(-3px); }
  .otro-card h3 { font-family:'Montserrat',sans-serif; font-weight:900; font-size:.88rem; text-transform:uppercase; letter-spacing:.05em; color:var(--blanco); margin-bottom:.4rem; }
  .otro-card p  { font-size:.78rem; color:rgba(255,255,255,.52); line-height:1.5; margin-bottom:.8rem; }
  .otro-card .pt{ font-family:'Bebas Neue',sans-serif; font-size:1.7rem; color:var(--amarillo); }

  /* bebidas */
  .beb-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:1rem; margin-top:1.5rem; }
  .beb-card { background:var(--gris2); border-radius:12px; padding:1rem 1.2rem; text-align:center; border:1px solid rgba(255,255,255,.06); transition:transform .2s; }
  .beb-card:hover { transform:translateY(-3px); }
  .beb-card .bic { font-size:1.8rem; margin-bottom:.3rem; }
  .beb-card h3   { font-size:.8rem; font-weight:700; color:var(--blanco); margin-bottom:.3rem; }
  .beb-card .bp  { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; color:var(--amarillo); }

  /* ingredientes extra */
  .extra-table { width:100%; border-collapse:collapse; margin-top:1rem; font-size:.82rem; }
  .extra-table th { background:rgba(26,46,204,.3); padding:7px 10px; text-align:center; font-size:.72rem; letter-spacing:.06em; color:var(--amarillo); }
  .extra-table td { padding:7px 10px; text-align:center; border-bottom:1px solid rgba(255,255,255,.06); color:rgba(255,255,255,.7); }
  .extra-table td:first-child { text-align:left; font-weight:700; color:var(--blanco); }
  .extra-table td.amt { color:var(--amarillo); font-weight:700; }

  /* ── CONTACTO ── */
  #contacto { background:linear-gradient(135deg,#020408,#080c20); }

  .con-grid { display:grid; grid-template-columns:1fr 1fr; gap:2.5rem; margin-top:2.5rem; align-items:start; }
  @media(max-width:680px){ .con-grid { grid-template-columns:1fr; } }
  .con-card { background:rgba(255,255,255,.04); border:1px solid rgba(26,46,204,.3); border-radius:18px; padding:2rem; }
  .con-card h3 { font-family:'Bebas Neue',sans-serif; font-size:1.8rem; letter-spacing:.07em; color:var(--azul); margin-bottom:1.3rem; }
  .con-row { display:flex; align-items:flex-start; gap:.75rem; margin-bottom:1.1rem; font-size:.88rem; color:rgba(255,255,255,.8); line-height:1.6; }
  .con-row .ic { font-size:1.2rem; flex-shrink:0; margin-top:.1rem; }
  .con-row strong { display:block; font-size:.68rem; font-weight:700; color:rgba(255,255,255,.4); letter-spacing:.12em; text-transform:uppercase; margin-bottom:.1rem; }
  .tel-big    { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; color:var(--rojo); letter-spacing:.04em; line-height:1.2; }
  .tel-big.wa { color:#25D366; }
  .hor-card { background:rgba(255,255,255,.04); border:1px solid rgba(204,26,26,.25); border-radius:18px; padding:2rem; }
  .hor-card h3 { font-family:'Bebas Neue',sans-serif; font-size:1.8rem; letter-spacing:.07em; color:var(--rojo); margin-bottom:1.3rem; }
  .hor-row { display:flex; justify-content:space-between; align-items:center; padding:.65rem 0; border-bottom:1px solid rgba(255,255,255,.07); font-size:.88rem; }
  .hor-row:last-child { border-bottom:none; }
  .hor-row .dias  { color:rgba(255,255,255,.6); }
  .hor-row .horas { font-weight:700; color:var(--amarillo); }

  /* ── FOOTER ── */
  footer { background:#020408; text-align:center; padding:1.5rem 1rem; font-size:.72rem; color:rgba(255,255,255,.28); font-family:'Montserrat',sans-serif; }
  footer span { color:var(--rojo); }

  /* ── REVEAL ── */
  .reveal { opacity:0; transform:translateY(26px); transition:opacity .6s ease,transform .6s ease; }
  .reveal.visible { opacity:1; transform:none; }

  @media(max-width:500px){ .tam-grid { grid-template-columns:1fr 1fr; } }
/* ══════════ SISTEMA DE PEDIDOS ══════════ */
  .order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    margin-top: .9rem;
    padding: .7rem 1rem;
    border: 0;
    border-radius: 10px;
    background: var(--oro);
    color: var(--negro);
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: .85rem;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .15s, filter .15s;
  }
  .order-btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
  .order-btn.rojo { background: var(--rojo); color: var(--blanco); }
  .order-btn.disabled { background: rgba(255,255,255,.08); color: rgba(255,255,255,.4); cursor: not-allowed; }

  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(5,5,5,.94);
    overflow-y: auto;
    padding: 18px;
  }

  .modal-content {
    max-width: 620px;
    margin: 18px auto;
    padding: 22px;
    background: linear-gradient(180deg, var(--gris2), var(--negro));
    border: 1px solid rgba(212,160,23,.3);
    border-radius: 18px;
    box-shadow: var(--shadow);
    font-family: 'Nunito', sans-serif;
  }

  .modal-head {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .modal-head h2 {
    margin: 0;
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: .05em;
    color: var(--oro);
    font-size: 1.5rem;
  }

  .close-btn {
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
    color: var(--blanco);
    cursor: pointer;
    font-weight: 900;
    flex: 0 0 auto;
  }

  .visual-box {
    display: grid;
    gap: 8px;
    margin: 14px 0;
  }

  /* Circulo: una circunferencia por cada pizza */
  .visual-box.shape-circle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    margin: 6px auto 18px;
  }

  .pizza-circle-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .pizza-circle-wrap .pizza-caption {
    font-size: .7rem;
    color: var(--muted);
    font-weight: 800;
    font-family: 'Montserrat', sans-serif;
  }

  .pizza-circle {
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid var(--oro);
    box-shadow:
      inset 0 0 0 3px rgba(0,0,0,.32),
      0 14px 28px rgba(0,0,0,.5);
    background: radial-gradient(circle, #f0c94a 0 58%, #c8201a 59% 68%, #6b120f 69%);
    flex: 0 0 auto;
  }

  .circle-fill {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12%;
    cursor: pointer;
    color: var(--blanco);
    font-family: 'Montserrat', sans-serif;
    font-size: .7rem;
    font-weight: 800;
    line-height: 1.15;
    text-shadow: 0 1px 3px rgba(0,0,0,.7);
    background: rgba(10,8,6,.45);
    transition: background .15s, box-shadow .15s;
    overflow: hidden;
    word-break: break-word;
  }

  .circle-fill.top {
    top: 0; bottom: auto; height: 50%; width: 100%;
    padding: 10% 10% 6% 10%;
    border-bottom: 1px dashed rgba(255,255,255,.55);
  }

  .circle-fill.bottom {
    top: auto; bottom: 0; height: 50%; width: 100%;
    padding: 6% 10% 10% 10%;
  }

  .circle-fill.selected {
    background: rgba(212,160,23,.9);
    color: var(--negro);
    text-shadow: none;
  }

  .circle-fill.active-slot {
    box-shadow: inset 0 0 0 3px var(--oro);
    background: rgba(255,255,255,.18);
  }

  .circle-fill.active-slot.selected { background: rgba(212,160,23,1); }

  /* Rectangulo/cuadrado: cuadricula para Mega y Barra */
  .visual-box.shape-rect,
  .visual-box.shape-square {
    display: grid;
    gap: 3px;
    margin: 6px auto 16px;
    border: 6px solid var(--oro);
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(180deg, #c8201a, #6b120f);
    box-shadow: 0 16px 34px rgba(0,0,0,.45);
  }

  .visual-box.shape-rect { width: 100%; aspect-ratio: 1.7 / 1; }
  .visual-box.shape-square { width: min(240px, 66vw); aspect-ratio: 1; }

  .rect-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    min-height: 0;
  }

  .rect-cell > div {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
    cursor: pointer;
    color: var(--blanco);
    font-family: 'Montserrat', sans-serif;
    font-size: .7rem;
    font-weight: 800;
    line-height: 1.15; 
    text-shadow: 0 1px 3px rgba(0,0,0,.7);
    background: rgba(10,8,6,.45);
    transition: background .15s;
    word-break: break-word;
  }

  .rect-cell > div.selected { background: rgba(212,160,23,.9); color: var(--negro); text-shadow: none; }
  .rect-cell > div.active-slot { box-shadow: inset 0 0 0 3px var(--oro); background: rgba(255,255,255,.18); }
  .rect-cell > div.active-slot.selected { background: rgba(212,160,23,1); }

  .extras-row {
    display: grid;
    gap: 8px;
    margin: 8px 0 12px;
  }

  .extras-col {
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    padding: 9px;
    background: rgba(255,255,255,.04);
    min-width: 0;
  }

  .chk-row {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    color: var(--muted);
    font-size: .78rem;
    font-family: 'Nunito', sans-serif;
  }

  .chk-row input[type="checkbox"] {
    width: 16px; height: 16px; min-height: auto; margin: 0;
    accent-color: var(--oro);
    flex: 0 0 auto;
  }

  .chk-price { margin-left: auto; color: var(--oro); font-size: .74rem; font-weight: 800; white-space: nowrap; }

  .picking-label {
    display: none;
    margin: 8px 0;
