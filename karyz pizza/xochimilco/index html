</div>


<script>
  const especialidades = [
    {n:"SUPER KARY'Z", i:"Champiñón, pollo, jitomate, chile cuaresmeño, chorizo, aguacate y queso"},
    {n:"MEXICANA", i:"Pierna, pollo, jalapeño, aguacate y queso"},
    {n:"ESPECIAL KARY'Z", i:"Jamón, atún, mayonesa, jitomate, jalapeños, aguacate y queso"},
    {n:"HAWAILAN CHICKEN", i:"Piña, tocino y pollo bañado de BBQ"},
    {n:"PEPPERONI", i:"Pepperoni (hasta 2 ingredientes)"},
    {n:"HAWAIANA INTER.", i:"Jamón, piña, cereza y queso"},
    {n:"HAWAIANA ESPECIAL", i:"Jamón, piña, tocino y queso"},
    {n:"COMBINADA", i:"Jamón, salami, champiñones, pimiento verde, cebolla, chorizo y queso"},
    {n:"CUBANA", i:"Atún, jalapeño, pierna, jitomate, tocino, aguacate y queso"},
    {n:"CHORIMANÍA", i:"Piña, aceituna, chorizo, champiñones y queso"},
    {n:"VEGETARIANA", i:"Champiñones, pimiento verde, cebolla, aceitunas y queso"},
    {n:"CLÁSICA", i:"Pepperoni, champiñones, chile cuaresmeño, cebolla y queso"},
    {n:"CARNES FRÍAS", i:"Pierna, lomo, salchicha, tocino, pepperoni y queso"},
    {n:"AZTECA", i:"Chorizo, frijoles, jalapeños, aguacate y queso"},
    {n:"CAMPESTRE", i:"Pollo, elote, jalapeño, cebolla y queso"},
    {n:"PASTOR", i:"Jamón, piña, chorizo, tocino y queso"},
    {n:"SUPREMA", i:"Salchicha, chorizo, tocino, cebolla, pimiento verde, aguacate y queso"},
    {n:"AMERICANA", i:"Pepperoni, champiñones, pimiento verde, aceituna y queso"},
    {n:"MAFIOSA", i:"Salami, champiñones, tocino, jalapeños, aguacate y queso"}
  ];

  const PREM = [
    {n:"AL PASTOR ESPECIAL", i:"Carne al pastor, piña, cebolla, chipotle o rajas de jalapeños y queso", r:2, g:"prem"},
    {n:"COSTILLA BBQ", i:"Costilla de puerco, cebolla y queso", r:2, g:"prem"},
    {n:"MÁXIMA", i:"Jamón, salami, carne molida, champiñones, salchicha, pimiento verde, cebolla, pepperoni, aceitunas y queso", r:2, g:"prem"},
    {n:"EXCÉNTRICA", i:"Salchicha, jamón, tocino, pierna, jitomate, aguacate y queso", r:2, g:"prem"},
    {n:"TROPICAL", i:"Camarones, piña y queso", r:4, g:"mar"},
    {n:"MARINERA", i:"Camarones, atún, mejillones, pulpo, aceitunas, cebolla y queso", r:5, g:"mar"}
  ];
  const SEN_REG = ["PIMIENTO VERDE","ACEITUNAS","CHAMPIÑONES","PIERNA","POLLO","ELOTE","CHORIZO","TOCINO","LOMO","JAMÓN","CEBOLLA","PIÑA","RAJAS","QUESO"].map(function(n) { return {n:"SENCILLA DE " + n, i:"Pizza de 1 ingrediente", r:0, g:"nor"}; });
  const SEN_MAR = ["CAMARONES","MEJILLONES","PULPO","ATÚN"].map(function(n) { return {n:"SENCILLA DE " + n, i:"Pizza de 1 ingrediente de mariscos", r:3, g:"mar"}; });
  const NORMALES = especialidades.map(function(x) { return {n:x.n, i:x.i, r:1, g:"nor"}; });
  const ALL = NORMALES.concat(PREM, SEN_MAR, SEN_REG);
  const TIER_NAMES = ["Sencilla regular", "Normal", "Premium", "Sencilla mariscos", "Tropical", "Marinera"];
  const TIER_PRICES = {Chica:[200,215,230,240,245,300], Mediana:[270,285,300,310,315,380], Grande:[360,375,390,400,405,455], Familiar:[400,415,430,440,445,500]};
  function rankOf(n) { const f = ALL.find(function(x) { return x.n === n; }); return f ? f.r : 0; }
  function currentRank() { let r = 0; slots.forEach(function(s) { if (s.sabor1) r = Math.max(r, rankOf(s.sabor1)); }); return r; }
  function tierPrice(size, r) { return TIER_PRICES[size][r]; }
  function tierName(r) { return TIER_NAMES[r]; }

  const MITAD_EXTRA = 10;
  let cart = [];
  let currentPicker = null;
  let slots = [];
  let activePizza = 0;
  let activeHalf = 1;
  let selectedPay = "Efectivo";
  let userLocation = "No enviada";

  function money(value) { return "$" + value.toFixed(2); }

  function makeSlots(limit) {
    slots = [];
    for (let i = 0; i < limit; i++) slots.push({sabor1: "", sabor2: "", mitad: false, extras: []});
    activePizza = 0;
    activeHalf = 1;
  }

  function openTwoForOne(size) {
    currentPicker = { type: size + " 2x1", mode: "normal", shape: "circle", basePrice: 0, limit: 2, tiered: true, size: size };
    makeSlots(2);
    document.getElementById("pickerTitle").innerText = size + " 2x1";
    document.getElementById("pickerSubtitle").innerText = "";
    renderPicker();
    document.getElementById("pickerModal").style.display = "block";
  }

  function openPickerRect(type, limit, price, details) {
    currentPicker = { type: type, mode: "rect", shape: type.indexOf("CUADRADA") >= 0 ? "square" : "rect", basePrice: price, details: details || [], limit: limit };
    makeSlots(limit);
    document.getElementById("pickerTitle").innerText = type;
    document.getElementById("pickerSubtitle").innerText = "Elige " + limit + " especialidades. ";
    renderPicker();
    document.getElementById("pickerModal").style.display = "block";
  }

  function renderPicker() {
    if (!currentPicker) return;
    renderVisual();
    renderExtras();
    renderPickingLabel();
    renderFlavorList();
    document.getElementById("pickerTotal").innerText = buildTotalText();
  }

  function renderVisual() {
    const preview = document.getElementById("visualPreview");
    preview.className = "visual-box shape-" + (currentPicker.shape || "circle");
    preview.innerHTML = "";
    if (currentPicker.shape === "circle") renderCircleVisual(preview);
    else renderGridVisual(preview);
  }

  function renderCircleVisual(preview) {
    const total = slots.length;
    const size = total <= 1 ? 190 : total === 2 ? 150 : total === 3 ? 118 : 96;
    slots.forEach(function(slot, index) {
      const wrap = document.createElement("div");
      wrap.className = "pizza-circle-wrap";
      const circle = document.createElement("div");
      circle.className = "pizza-circle";
      circle.style.width = size + "px";
      circle.style.height = size + "px";
      if (slot.mitad) {
        circle.appendChild(makeCircleFill(index, 1, "top", slot.sabor1 ? slot.sabor1 : "Sabor 1"));
        circle.appendChild(makeCircleFill(index, 2, "bottom", slot.sabor2 ? slot.sabor2 : "Sabor 2"));
      } else {
        circle.appendChild(makeCircleFill(index, 1, "", slot.sabor1 || "Sabor " + (index + 1)));
      }
      wrap.appendChild(circle);
      if (total > 1) {
        const caption = document.createElement("span");
        caption.className = "pizza-caption";
        caption.innerText = "Pizza " + (index + 1);
        wrap.appendChild(caption);
      }
      preview.appendChild(wrap);
    });
  }

  function makeCircleFill(index, half, side, label) {
    const div = document.createElement("div");
    const slot = slots[index];
    const filled = half === 2 ? !!slot.sabor2 : !!slot.sabor1;
    div.className = "circle-fill" + (side ? " " + side : "") + (filled ? " selected" : "") + (activePizza === index && (!slot.mitad || activeHalf === half) ? " active-slot" : "");
    div.innerText = label;
    if (filled && currentPicker.tiered) { const r = rankOf(half === 2 ? slot.sabor2 : slot.sabor1); const g = (ALL.find(function(x) { return x.n === (half === 2 ? slot.sabor2 : slot.sabor1); }) || {}).g; if (g === "prem") div.className += " t-p"; else if (g === "mar") div.className += " t-m"; else if (g === "nor") div.className += " t-n"; }
    div.onclick = function() { startPicking(index, half); };
    return div;
  }

  function renderGridVisual(preview) {
    const total = slots.length;
    const cols = Math.ceil(Math.sqrt(total));
    const rows = Math.ceil(total / cols);
    preview.style.gridTemplateColumns = "repeat(" + cols + ", 1fr)";
    preview.style.gridTemplateRows = "repeat(" + rows + ", 1fr)";
    slots.forEach(function(slot, index) {
      const cell = document.createElement("div");
      cell.className = "rect-cell";
      cell.appendChild(makeRectHalf(index, 1, slot.sabor1 || "Sabor " + (index + 1)));
      preview.appendChild(cell);
    });
  }

  function makeRectHalf(index, half, label) {
    const div = document.createElement("div");
    const slot = slots[index];
    const filled = !!slot.sabor1;
    div.className = (filled ? "selected" : "") + (activePizza === index ? " active-slot" : "");
    div.innerText = label;
    div.onclick = function() { startPicking(index, 1); };
    return div;
  }

  const EXTRA_PRICES = {Chica:[15,20], Mediana:[20,25], Grande:[25,30], Familiar:[30,35]};
  const EXTRA_REG = ["PIMIENTO VERDE","ACEITUNAS","CHAMPIÑONES","PIERNA","POLLO","ELOTE","CHORIZO","TOCINO","LOMO","JAMÓN","CEBOLLA","PIÑA","RAJAS","QUESO"];
  const EXTRA_MAR = ["CAMARONES","MEJILLONES","PULPO","ATÚN"];
  function extraPrice(name) { return EXTRA_PRICES[currentPicker.size][EXTRA_MAR.indexOf(name) >= 0 ? 1 : 0]; }
  function extraCost(slot) { return currentPicker && currentPicker.tiered ? (slot.extras || []).reduce(function(s, e) { return s + extraPrice(e); }, 0) : 0; }
  function extrasTotal() { return slots.reduce(function(s, sl) { return s + extraCost(sl); }, 0); }
  function addExtra(index) { const sel = document.getElementById("extraSel-" + index); if (!sel || !sel.value) return; slots[index].extras.push(sel.value); renderPicker(); }
  function removeExtra(index, k) { slots[index].extras.splice(k, 1); renderPicker(); }

  function renderExtras() {
    const row = document.getElementById("extrasRow");
    if (!currentPicker.tiered) { row.style.display = "none"; row.innerHTML = ""; return; }
    row.style.display = "grid";
    row.style.gridTemplateColumns = "repeat(2, minmax(0, 1fr))";
    const P = EXTRA_PRICES[currentPicker.size];
    const opt = function(n) { return '<option value="' + n + '">' + n + '</option>'; };
    row.innerHTML = slots.map(function(slot, index) {
      const chips = slot.extras.map(function(e, k) { return '<span class="extra-chip">' + e + ' +$' + extraPrice(e) + ' <button type="button" onclick="removeExtra(' + index + ',' + k + ')">✕</button></span>'; }).join("");
      return '<div class="extras-col"><div class="extra-title">Pizza ' + (index + 1) + ' · ingredientes extra</div>'
        + '<select id="extraSel-' + index + '" onchange="addExtra(' + index + ')"><option value="">+ Ingrediente extra</option>'
        + '<optgroup label="Regular +$' + P[0] + ' c/u">' + EXTRA_REG.map(opt).join("") + '</optgroup>'
        + '<optgroup label="🌊 Mariscos +$' + P[1] + ' c/u">' + EXTRA_MAR.map(opt).join("") + '</optgroup></select><div>' + chips + '</div></div>';
    }).join("");
  }

  function startPicking(index, half) {
    activePizza = index;
    activeHalf = half || 1;
    renderPicker();
  }

  function toggleMitad(index) {
    slots[index].mitad = document.getElementById("mitad-" + index).checked;
    if (!slots[index].mitad) slots[index].sabor2 = "";
    if (activePizza === index) activeHalf = 1;
    renderPicker();
  }

  function renderPickingLabel() {
    const label = document.getElementById("pickingLabel");
    if (!currentPicker || currentPicker.mode !== "normal") { label.style.display = "none"; return; }
    const pizzaText = currentPicker.limit > 1 ? "Pizza " + (activePizza + 1) : "Pizza";
    const halfText = slots[activePizza] && slots[activePizza].mitad ? (activeHalf === 1 ? " - 1/2 sabor 1" : " - 1/2 sabor 2") : "";
    label.innerText = "Eligiendo: " + pizzaText + halfText + ". Toca un sabor de la lista.";
    label.style.display = "block";
  }

  function rowHtml(item, cls, price) {
    return '<div class="option-row ' + cls + '"><div><strong>' + item.n + '</strong><small>' + item.i + '</small>' + (price ? '<span class="tier-price ' + cls + '">2x1 ' + money(price) + '</span>' : '') + '</div><button class="flavor-btn" onclick="selectFlavor(&quot;' + item.n + '&quot;)">+</button></div>';
  }

  function renderFlavorList() {
    const list = document.getElementById("flavorList");
    if (!currentPicker.tiered) { list.innerHTML = (currentPicker.allowed || especialidades).map(function(x) { return rowHtml(x, "", 0); }).join(""); return; }
    const P = TIER_PRICES[currentPicker.size];
    const group = function(title, cls, items, extra) { return '<div class="flavor-group ' + cls + (extra ? ' ' + extra : '') + '">' + title + '</div>' + items.map(function(x) { return rowHtml(x, cls, P[x.r]); }).join(""); };
    list.innerHTML = group("Especialidades normales", "nor", NORMALES)
      + group("⭐ Premium", "prem", PREM.filter(function(x) { return x.g === "prem"; }))
      + group("🌊 Mariscos", "mar", PREM.filter(function(x) { return x.g === "mar"; }))
      + group("🍕 Sencillas regular (1 ingrediente)", "nor", SEN_REG, "sep")
      + group("🌊 Sencillas de mariscos (1 ingrediente)", "mar", SEN_MAR);
  }

  function selectFlavor(name) {
    if (!currentPicker) return;
    if (activePizza < 0) activePizza = 0;
    if (currentPicker.mode === "normal" && activeHalf === 2 && slots[activePizza].mitad) slots[activePizza].sabor2 = name;
    else slots[activePizza].sabor1 = name;

    for (let i = 0; i < slots.length; i++) {
      if (!slots[i].sabor1) { activePizza = i; activeHalf = 1; renderPicker(); return; }
      if (currentPicker.mode === "normal" && slots[i].mitad && !slots[i].sabor2) { activePizza = i; activeHalf = 2; renderPicker(); return; }
    }
    activePizza = 0;
    activeHalf = 1;
    renderPicker();
  }

  function calculatePickerTotal() {
    if (!currentPicker) return 0;
    if (currentPicker.tiered) return tierPrice(currentPicker.size, currentRank()) + extrasTotal();
    let total = currentPicker.basePrice;
    if (currentPicker.mode === "normal") {
      slots.forEach(function(slot) { if (slot.mitad) total += MITAD_EXTRA; });
    }
    return total;
  }

  function buildTotalText() {
    if (currentPicker.tiered) {
      if (!slots.some(function(s) { return s.sabor1; })) return "Elige tus 2 sabores";
      return "Precio " + tierName(currentRank()) + (extrasTotal() ? " + extras $" + extrasTotal() : "") + " -> Total: " + money(calculatePickerTotal());
    }
    const parts = [];
    if (currentPicker.mode === "normal") {
      slots.forEach(function(slot, index) {
        const label = currentPicker.limit > 1 ? "P" + (index + 1) + ": " : "";
        if (slot.mitad) parts.push(label + "Mitad +$" + MITAD_EXTRA);
      });
    }
    return (parts.length ? parts.join(" | ") + " -> " : "") + "Total: " + money(calculatePickerTotal());
  }

  function confirmPicker() {
    if (!currentPicker) return;
    for (let i = 0; i < currentPicker.limit; i++) {
      if (!slots[i].sabor1) { alert("Elige el sabor de la Pizza " + (i + 1)); return; }
      if (currentPicker.mode === "normal" && slots[i].mitad && !slots[i].sabor2) { alert("Elige el segundo sabor de la Pizza " + (i + 1)); return; }
    }
    const details = [];
    if (currentPicker.details) currentPicker.details.forEach(function(d) { details.push(d); });
    slots.forEach(function(slot, index) {
      let desc = currentPicker.limit > 1 ? "Pizza " + (index + 1) + ": " : "Pizza: ";
      desc += slot.mitad ? slot.sabor1 + " / " + slot.sabor2 + " (mitad y mitad)" : slot.sabor1;
      if (slot.mitad) desc += " + mitad $" + MITAD_EXTRA;
      if (slot.extras && slot.extras.length) desc += " + extras: " + slot.extras.join(", ") + " (+$" + extraCost(slot) + ")";
      details.push(desc);
    });
    if (currentPicker.tiered) details.push("Precio aplicado: " + tierName(currentRank()) + " (" + currentPicker.size + ")");
    cart.push({type: currentPicker.type, flavors: details, price: calculatePickerTotal()});
    closeModal();
    updateStats();
  }

  function closeModal() { document.getElementById("pickerModal").style.display = "none"; }

  function addToCartDirect(name, price, details) {
    cart.push({type: name, flavors: details || [], price: price});
    updateStats();
    alert(name + " agregado al carrito");
  }

  function updateStats() {
    const total = cart.reduce(function(sum, item) { return sum + item.price; }, 0);
    document.getElementById("cartCount").innerText = cart.length + (cart.length === 1 ? " articulo" : " articulos");
    document.getElementById("cartTotal").innerText = money(total);
    calculateFinalTotal();
  }

  function openCart() {
    document.getElementById("cartModal").style.display = "block";
    const items = document.getElementById("cartItems");
    if (!cart.length) {
      items.innerHTML = '<div class="notice">Tu carrito esta vacio. Agrega una pizza o promocion para continuar.</div>';
    } else {
      items.innerHTML = cart.map(function(item, index) {
        const detailHtml = item.flavors.map(function(d) { return "<div>- " + d + "</div>"; }).join("");
        return '<div class="cart-item"><button class="cart-remove" onclick="removeItem(' + index + ')">X</button><strong>' + item.type + '</strong> <span style="color:var(--oro);">' + money(item.price) + '</span><div style="margin-top:6px;">' + detailHtml + "</div></div>";
      }).join("");
    }
    calculateFinalTotal();
  }

  function closeCart() { document.getElementById("cartModal").style.display = "none"; }

  function removeItem(index) { cart.splice(index, 1); updateStats(); openCart(); }

  function setPay(method) {
    selectedPay = method;
    document.querySelectorAll(".pay-option").forEach(function(el) { el.classList.remove("active"); });
    document.getElementById("p-" + method.substring(0, 3).toLowerCase()).classList.add("active");
    const info = document.getElementById("paymentInfo");
    if (method === "Efectivo") {
      info.style.display = "none";
    } else if (method === "Transferencia") {
      info.style.display = "block";
      info.innerHTML = "<strong>Transferencia:</strong> envia tu comprobante por WhatsApp despues de mandar el pedido.";
    } else {
      info.style.display = "block";
      info.innerHTML = "<strong>Tarjeta:</strong> se agrega 4% al total. Aceptamos MasterCard y Visa.";
    }
    calculateFinalTotal();
  }

  function calculateFinalTotal() {
    let total = cart.reduce(function(sum, item) { return sum + item.price; }, 0);
    if (selectedPay === "Tarjeta") total *= 1.04;
    document.getElementById("finalTotal").innerText = "Total: " + money(total);
  }

  function getLocation() {
    if (!navigator.geolocation) {
      document.getElementById("geoStatus").innerText = "Tu navegador no permite enviar ubicacion.";
      return;
    }
    navigator.geolocation.getCurrentPosition(
      function(position) {
        userLocation = "https://www.google.com/maps?q=" + position.coords.latitude + "," + position.coords.longitude;
        document.getElementById("geoStatus").innerText = "Ubicacion capturada correctamente.";
      },
      function() { document.getElementById("geoStatus").innerText = "No se pudo capturar la ubicacion."; }
    );
  }

  const REQUIRED_FIELDS = [
    ["customerName", "Nombre completo"], ["customerPhone", "Teléfono"], ["customerNeighborhood", "Colonia"],
    ["customerAddress", "Dirección"], ["customerBetweenStreets", "Entre qué calles"],
    ["customerGate", "Color de zaguán"], ["customerFacade", "Color de fachada"]
  ];
  REQUIRED_FIELDS.forEach(function(f) {
    const el = document.getElementById(f[0]);
    el.addEventListener("input", function() { el.classList.remove("field-error"); });
  });

  function sendWhatsApp() {
    if (!cart.length) { alert("Agrega productos al carrito."); return; }
    const name = document.getElementById("customerName").value.trim();
    const phone = document.getElementById("customerPhone").value.trim();
    const address = document.getElementById("customerAddress").value.trim();
    const betweenStreets = document.getElementById("customerBetweenStreets").value.trim();
    const missing = [];
    REQUIRED_FIELDS.forEach(function(f) {
      const el = document.getElementById(f[0]);
      const empty = !el.value.trim();
      el.classList.toggle("field-error", empty);
      if (empty) missing.push(f[1]);
    });
    const errBox = document.getElementById("formError");
    if (missing.length) {
      errBox.innerHTML = "⚠️ Faltan datos por llenar para enviar tu pedido:<br>" + missing.join(", ") + ".";
      errBox.style.display = "block";
      errBox.scrollIntoView({behavior: "smooth", block: "center"});
      return;
    }
    errBox.style.display = "none";
    let total = cart.reduce(function(sum, item) { return sum + item.price; }, 0);
    if (selectedPay === "Tarjeta") total = Math.round(total * 1.04 * 100) / 100;
    
    let msg = "*KARY'Z PIZZA XOCHIMILCO - PEDIDO*\n";
    msg += "Cliente: " + name + "\n";
    msg += "Telefono: " + phone + "\n";
    msg += "Colonia: " + document.getElementById("customerNeighborhood").value.trim() + "\n";
    msg += "Direccion: " + address + "\n";
    msg += "Entre calles: " + betweenStreets + "\n";
    msg += "Color de zaguan: " + document.getElementById("customerGate").value.trim() + "\n";
    msg += "Color de fachada: " + document.getElementById("customerFacade").value.trim() + "\n";
    msg += "GPS: " + userLocation + "\n";
    msg += "Notas: " + document.getElementById("customerNotes").value + "\n";
    msg += "----------------\n";
    cart.forEach(function(item) {
      msg += "- " + item.type + " " + money(item.price) + "\n";
      item.flavors.forEach(function(d) { msg += "  * " + d + "\n"; });
    });
    msg += "----------------\n";
    msg += "Pago: " + selectedPay + "\n";
    msg += "TOTAL: " + money(total);
    if (selectedPay === "Tarjeta") msg += " (incluye 4% por pago con tarjeta)";
    if (selectedPay === "Transferencia") msg += "\nEnviar comprobante por este chat.";
    window.open("https://wa.me/525611750154?text=" + encodeURIComponent(msg), "_blank");
  }

  updateStats();

function openSpecial(name,price,limit,allowed,details){
 currentPicker={type:name,mode:'rect',shape:limit===4?'square':'rect',basePrice:price,limit:limit,allowed:allowed||especialidades,details:details||[limit===4?'24 rebanadas · 52 × 38 cm · Refresco de 2 litros':'12 rebanadas · 52 × 19 cm · Refresco de 1 litro']};
 makeSlots(limit);document.getElementById('pickerTitle').innerText=name;document.getElementById('pickerSubtitle').innerText='Elige '+limit+' especialidad(es).';renderPicker();document.getElementById('pickerModal').style.display='block';
}
function openPackage(n){
 if(n===1){addToCartDirect('Paquete 1',355,['2 pizzas grandes hawaianas']);return;}
 const cfg={2:['Paquete 2 · Super Kary’z',270,especialidades,['1 pizza familiar a su gusto','Coca-Cola de 1 litro','Excepto Premium y Mariscos']],3:['Paquete 3 · Familiar de Dedos',315,NORMALES.concat(PREM.filter(x=>x.g==='prem')),['Pizza familiar de dedos','Coca-Cola de 1 litro','Excepto Mariscos']],4:['Paquete 4 · Corazón',255,especialidades,['Pizza en forma de corazón','2 refrescos de lata']]};
 const p=cfg[n];openSpecial(p[0],p[1],1,p[2],p[3]);currentPicker.shape='circle';renderPicker();
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeCart();}});
const sizes=['CH','MED','GDE','FAM'];document.querySelectorAll('.strip').forEach(s=>{s.innerHTML=s.dataset.p.split(',').map((p,i)=>'<div class="s'+i+'"><small>'+sizes[i]+'</small><b>$'+p+'</b></div>').join('');});
</script></body>
</html>
